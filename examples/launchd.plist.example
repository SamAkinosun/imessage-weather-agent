<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for sending the daily weather iMessage at 7:00 AM local.

  Install:
    1. Edit ProgramArguments paths below to match your install.
    2. Copy to ~/Library/LaunchAgents/com.example.imessage-weather.plist
    3. launchctl load ~/Library/LaunchAgents/com.example.imessage-weather.plist
    4. To run once now (verifies it works):
         launchctl start com.example.imessage-weather

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.example.imessage-weather.plist
    rm ~/Library/LaunchAgents/com.example.imessage-weather.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.imessage-weather</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/imessage-weather</string>
    <string>--config</string>
    <string>/Users/YOU/path/to/config.yaml</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/imessage-weather.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/imessage-weather.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
